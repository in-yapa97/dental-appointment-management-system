# =============================================================================
# Root .gitignore for Dental Appointment and Patient Management System
# =============================================================================

# Environment and Secret Files
.env
.env.local
.env.*.local
*.env
secrets/
*.pem
*.key

# Operating System & Editor Artifacts
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# IDE and Editor Configurations
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Frontend (React / Vite / Node)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.pnpm-debug.log*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.eslintcache
frontend/.turbo
frontend/*.tsbuildinfo
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Backend (Java / Spring Boot / Maven)
# -----------------------------------------------------------------------------
backend/target/
backend/*.jar
backend/*.war
backend/*.nar
backend/*.ear
backend/*.zip
backend/*.tar.gz
backend/*.rar
backend/bin/
backend/.mvn/timing.properties
backend/.mvn/wrapper/maven-wrapper.jar

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Coverage & Reports
coverage/
*.lcov
.nyc_output
backend/target/surefire-reports/
backend/target/site/
