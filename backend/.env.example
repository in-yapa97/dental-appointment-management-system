# -----------------------------------------------------------------------------
# Backend Environment Configuration Template
# Copy this file to .env (do NOT commit .env with real credentials)
# -----------------------------------------------------------------------------

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Full JDBC URL (optional, automatically composed from above if omitted)
# DB_URL=jdbc:postgresql://localhost:5432/dental_db

# Hibernate DDL Auto (update, validate, create-drop, none)
JPA_DDL_AUTO=update

# JWT Authentication Configuration (Base64-encoded 256-bit secret)
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_here
JWT_EXPIRATION_MS=86400000

